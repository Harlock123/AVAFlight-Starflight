  {
    "id": "minstrel", "name": "Minstrels", "baseAttitude": 40, "portraitColor": "#FFFFFF",
    "description": "Space-dwelling beings, also called the Delasa'alia, who communicate telepathically in verse.",
    "disposition": "Peaceful and unafraid. Their songs carry the true history of the Ancients.",
    "postureEffect": { "Friendly": 2, "Obsequious": 2, "Hostile": -3 },
    "syllables": "la ei oo ah ae",
    "ship": { "hull": 300, "shield": 1000, "laserDamage": 0, "missileDamage": 0, "speed": 1.4, "aggression": 0.0, "missileResistant": false },
    "fleetSize": 1,
    "greetings": ["(No transmission, yet you hear it:) 'Small warm ones adrift, come and hear the old song sung...'"],
    "farewells": ["'Drift on, drift on, little flame, the dark is long and the song the same.'"],
    "hostileLines": ["'Sharp words, sharp light; the song goes quiet in the night.'"],
    "surrenderLines": ["'We do not fight. We only sing.'"],
    "answers": {
      "Themselves": [ { "text": "'We are the singers, the Delasa'alia, who were old when your sun was new.'" } ],
      "OtherRaces": [ { "text": "'Wave on wave the peoples flee, from core to rim, from fire to sea.'", "logNote": "Minstrels sing of whole races fleeing in waves from core to rim, ahead of fire." } ],
      "OldEmpire": [ { "text": "'Your empire bright, your empire wide, went down in flame when its sun had died.'" } ],
      "Ancients": [
        { "text": "'First came the crystal few, slow as stone and cold as dew. Warm life spread, a creeping stain; they light the suns to burn it again.'", "setsFlag": "minstrel_crystal_song", "logNote": "Minstrels: the 'crystal few' came first and see warm life as a stain. They ignite suns to burn it away." },
        { "text": "'Find the stone that dreams below your feet; the fuel you burn, the foe you meet.'", "minAttitude": 45, "logNote": "Minstrel riddle: the fuel we burn and the foe we meet are the same." }
      ],
      "General": [ { "text": "'Listen, listen: suns that sing will burn before the coming spring.'" } ]
    }
  },
